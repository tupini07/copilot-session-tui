{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "copilot-session-tui hook-event session-start",
        "timeoutSec": 8
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "command": "copilot-session-tui hook-event working",
        "timeoutSec": 8
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "command": "copilot-session-tui hook-event ready",
        "timeoutSec": 8
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "command": "copilot-session-tui hook-event error",
        "timeoutSec": 8
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "command": "copilot-session-tui hook-event session-end",
        "timeoutSec": 8
      }
    ],
    "notification": [
      {
        "type": "command",
        "matcher": "permission_prompt|elicitation_dialog",
        "command": "copilot-session-tui hook-event notification",
        "timeoutSec": 8
      }
    ]
  }
}
