# /peek answers once with the session's screen as it is right now, for the user who
# wants to look without opening a live view. In a private chat a bare /unfollow, as
# tapping the one in a follow's footer sends it, stops every follow rather than asking
# which.

size 110x30
arg --mux
fake_telegram private
session existing-app Existing app session
timeout 40000

wait_for Existing app session
press enter
wait_for Fake Copilot is idling

type e2e:work 1500 Setup is done.
press enter
press ctrl+b d
wait_for Existing app session
telegram_wait Setup is done.

# /peek is a picture of the screen, drawn by CST, with the session named under it;
# /peek text is the same screen as a monospace block. Neither types into the session.
telegram_say /peek
telegram_wait photo
telegram_wait : <b>Peek: Existing app session</b>
telegram_say /peek text
telegram_wait message: <b>Peek: Existing app session</b>
telegram_wait Fake Copilot is idling.
telegram_wait Fake Copilot received: e2e:work 1500 Setup is done.
telegram_dump 01-peeked
press enter
expect_not Fake Copilot received: /peek
dump 01-session-untouched
press ctrl+b d
wait_for Existing app session

# A follow, then the footer's bare /unfollow ends it.
telegram_say /follow
telegram_wait Following
telegram_wait Send /unfollow to stop
telegram_say_bare /unfollow
telegram_wait Follow stopped
telegram_dump 02-stopped-bare
